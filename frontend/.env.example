# --- Local development ---------------------------------------------------
# SQLite database file used by Prisma (created by `prisma db push`)
DATABASE_URL="file:./db/custom.db"

# --- BioAgent-ST backend integration ------------------------------------
# Base URL of the BioAgent-ST API. When set, the frontend calls the backend
# instead of serving in-browser demo data. Leave unset for demo mode.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
